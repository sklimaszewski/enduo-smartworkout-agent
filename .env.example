# Enduo SmartWorkout Agent configuration. Copy to .env (never commit it). Nothing here is required.

# --- Enduo ---------------------------------------------------------------------------------------
# ENDUO_URL=https://api.enduo.app
# Name of the container in Enduo, shown with its token (default: "SmartWorkout Agent (<hostname>)").
# ENDUO_CLIENT_NAME=
# A personal access token with the "write:strength" scope instead of signing in with a code.
# ENDUO_TOKEN=

# --- Sync ----------------------------------------------------------------------------------------
# How often SmartWorkout is asked for new workouts, in seconds (at least 30).
# POLL_SECONDS=300
# On the first run, send the workouts of this many days back; older ones are skipped. 0 sends only new ones.
# BACKFILL_DAYS=90

# Language of the exercise names, or a list such as "pl,en" (default: en). SmartWorkout names its own exercises
# in English only; an exercise you added keeps the language the app was in. A missing name falls back to English.
# EXERCISE_LANGUAGE=en

# --- Optional Strava export -----------------------------------------------------------------------
# Disabled by default. Sends only workouts STARTED after the first enabled service pass; no history/backfill.
# Uses Strava's structured JSON strength upload, with remaining details in the activity description.
# STRAVA_ENABLED=false
# Register your own application at https://www.strava.com/settings/api (callback domain: localhost).
# Then run `enduo-smartworkout setup --strava` and approve activity:read_all + activity:write.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Local UTC offset shown by Strava, calculated for each workout date (including daylight saving time).
# STRAVA_TIMEZONE=Europe/Warsaw
# Optional: bootstrap with an already authorized refresh token instead of the browser setup.
# The rotated token in /data/strava.json takes precedence. Remove this ENV token after connecting.
# STRAVA_REFRESH_TOKEN=
# Only change this when using another callback domain registered with Strava. No listening port is required.
# STRAVA_REDIRECT_URI=http://localhost/strava/callback

# --- SmartWorkout session, read once by `enduo-smartworkout setup` (it asks for them when they are not set) ---
# SMARTWORKOUT_ACCESS_TOKEN=
# SMARTWORKOUT_REFRESH_TOKEN=

# --- User-Agent ------------------------------------------------------------------------------------
# Both default to "enduo-smartworkout-agent/<version> (+https://github.com/sklimaszewski/enduo-smartworkout-agent)".
# What the SmartWorkout iOS app sends looks like "SmartWorkout/1634 CFNetwork/3860.700.2 Darwin/25.6.0".
# SMARTWORKOUT_USER_AGENT=
# ENDUO_USER_AGENT=
